<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>true</IsPackable>
		<!-- The analyzers of trimming and NativeAOT run on the target that has them. -->
		<IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</IsAotCompatible>
		<VersionPrefix>2.4.2</VersionPrefix>
		<PackageId>ChromaDB.Client.DependencyInjection</PackageId>
		<!-- -p:PackageIdPrefix=Name publishes the package as Name.Client.DependencyInjection. -->
		<PackageId Condition="'$(PackageIdPrefix)' != ''">$(PackageIdPrefix).Client.DependencyInjection</PackageId>
		<Authors>ssone95, cincuranet, ChromaDotNet contributors</Authors>
		<PackageDescription>.NET SDK for Chroma database</PackageDescription>
		<PackageTags>chroma chromadb vector database</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RepositoryType>git</RepositoryType>
		<RepositoryUrl>https://github.com/ssone95/ChromaDB.Client</RepositoryUrl>
		<PackageProjectUrl>https://github.com/ssone95/ChromaDB.Client</PackageProjectUrl>
		<!-- In GitHub Actions the links point to the repository that builds the package. -->
		<RepositoryUrl Condition="'$(GITHUB_REPOSITORY)' != ''">https://github.com/$(GITHUB_REPOSITORY)</RepositoryUrl>
		<PackageProjectUrl Condition="'$(GITHUB_REPOSITORY)' != ''">https://github.com/$(GITHUB_REPOSITORY)</PackageProjectUrl>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PackageReleaseNotes>2.4.1: works in applications published with trimming or NativeAOT, with IsAotCompatible. 2.4.0: AddChromaClient and AddKeyedChromaClient register one ChromaClient singleton per key, so also singletons can take it; its HttpClient takes the current handler of IHttpClientFactory at each request, renewed after two minutes by default, on every target. 2.3.0: AddKeyedChromaClient registers a client and its options under a key. 2.0.0: AddChromaClient registers the options, which the client needs. Release notes of the client: $(PackageProjectUrl)/releases</PackageReleaseNotes>
	</PropertyGroup>
	<ItemGroup>
		<None Include="..\README.md" Pack="true" PackagePath="\" />
		<None Include="..\LICENSE" Pack="true" PackagePath="\" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\ChromaDB.Client\ChromaDB.Client.csproj" />
	</ItemGroup>
</Project>
