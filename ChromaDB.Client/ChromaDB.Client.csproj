<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>true</IsPackable>
		<VersionPrefix>2.0.1</VersionPrefix>
		<PackageId>ChromaDB.Client</PackageId>
		<!-- -p:PackageIdPrefix=Name publishes the package as Name.Client. -->
		<PackageId Condition="'$(PackageIdPrefix)' != ''">$(PackageIdPrefix).Client</PackageId>
		<Authors>ssone95, cincuranet, ChromaDotNet contributors</Authors>
		<PackageDescription>.NET SDK for Chroma database</PackageDescription>
		<PackageTags>chroma chromadb vector database</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RepositoryType>git</RepositoryType>
		<RepositoryUrl>https://github.com/ssone95/ChromaDB.Client</RepositoryUrl>
		<PackageProjectUrl>https://github.com/ssone95/ChromaDB.Client</PackageProjectUrl>
		<!-- In GitHub Actions the links point to the repository that builds the package. -->
		<RepositoryUrl Condition="'$(GITHUB_REPOSITORY)' != ''">https://github.com/$(GITHUB_REPOSITORY)</RepositoryUrl>
		<PackageProjectUrl Condition="'$(GITHUB_REPOSITORY)' != ''">https://github.com/$(GITHUB_REPOSITORY)</PackageProjectUrl>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PackageReleaseNotes>2.0.0: uses the Chroma v2 API, so the configuration URI ends with /api/v2/. Other breaking changes: ChromaCollectionQueryEntry.Distance is float?, null when the query does not include distances; every async method takes an optional CancellationToken as its last parameter. Fixed: Modify, AddChromaClient, the request URLs of the netstandard2.0 build, the error messages, and the HttpClient passed to the clients is no longer modified. Migration: $(PackageProjectUrl)#migrating-from-chromadbclient-1x</PackageReleaseNotes>
	</PropertyGroup>
	<ItemGroup>
		<None Include="..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)'=='netstandard2.0'">
		<PackageReference Include="PolySharp" Version="1.14.1">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
		</PackageReference>
		<PackageReference Include="System.Memory" Version="4.5.5" />
		<PackageReference Include="System.Text.Json" Version="8.0.5" />
	</ItemGroup>
</Project>
