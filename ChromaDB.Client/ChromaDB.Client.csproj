<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>true</IsPackable>
		<!-- The analyzers of trimming and NativeAOT run on the target that has them. -->
		<IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</IsAotCompatible>
		<VersionPrefix>2.6.1</VersionPrefix>
		<PackageId>ChromaDB.Client</PackageId>
		<!-- -p:PackageIdPrefix=Name publishes the package as Name.Client. -->
		<PackageId Condition="'$(PackageIdPrefix)' != ''">$(PackageIdPrefix).Client</PackageId>
		<Authors>ssone95, cincuranet, ChromaDotNet contributors</Authors>
		<PackageDescription>.NET client for Chroma, the vector database: tested with Chroma 0.4.10 to 1.5.9 and with Chroma Cloud.</PackageDescription>
		<PackageTags>chroma chromadb vector database</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RepositoryType>git</RepositoryType>
		<RepositoryUrl>https://github.com/ssone95/ChromaDB.Client</RepositoryUrl>
		<PackageProjectUrl>https://github.com/ssone95/ChromaDB.Client</PackageProjectUrl>
		<!-- In GitHub Actions the links point to the repository that builds the package. -->
		<RepositoryUrl Condition="'$(GITHUB_REPOSITORY)' != ''">https://github.com/$(GITHUB_REPOSITORY)</RepositoryUrl>
		<PackageProjectUrl Condition="'$(GITHUB_REPOSITORY)' != ''">https://github.com/$(GITHUB_REPOSITORY)</PackageProjectUrl>
		<IncludeSymbols>true</IncludeSymbols>
		<!-- The XML documentation of the public API goes in the package, for IntelliSense. -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);RS0026;RS0027</NoWarn>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PackageReleaseNotes>2.6.0: the rest of the v2 API: ChromaWhereDocumentOperator.Regex and NotRegex; Delete(ChromaDelete) by filters, with a limit and the count of the deleted records; ModifyConfiguration, for the settings of the index of the collection; Healthcheck; Count(ChromaReadLevel); ChromaClient.WithTenantAndDatabaseFromIdentity; for Chroma Cloud Fork, ForkCount, GetIndexingStatus, AttachFunction, GetAttachedFunction, DetachFunction, GetCollectionByCrn and UpdateTenant. XML documentation in the package. Fixed: ChromaCollection.Space also reads the space that Chroma Cloud sends in the spann configuration; the validation errors of the 0.x servers are the message of the exception. 2.5.0: embeddings in base64 where the server declares supports_base64_encoding; WithBatchSplitting(maxBatchSize) for servers like Chroma Cloud, which declares 1000 but takes 300 records per write; ChromaException.ErrorType; CollectionExists also by a NotFoundError about a collection. 2.4.1: works in applications published with trimming or NativeAOT: serialization with metadata generated at build time, IsAotCompatible. All the releases: $(PackageProjectUrl)/releases. Tested versions: $(PackageProjectUrl)/blob/main/docs/COMPATIBILITY.md. Migration from 1.x: $(PackageProjectUrl)#migrating-from-chromadbclient-1x</PackageReleaseNotes>
	</PropertyGroup>
	<ItemGroup>
		<!-- The public API, checked at build: PublicAPI.Shipped.txt is the API of the last release, PublicAPI.Unshipped.txt what was
		     added since. RS0026 and RS0027 are about overloads with optional parameters, the design the API already has. -->
		<PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" PrivateAssets="all" />
	</ItemGroup>
	<ItemGroup>
		<None Include="..\README.md" Pack="true" PackagePath="\" />
		<None Include="..\LICENSE" Pack="true" PackagePath="\" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)'=='netstandard2.0'">
		<PackageReference Include="PolySharp" Version="1.14.1">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
		</PackageReference>
		<PackageReference Include="System.Memory" Version="4.5.5" />
		<PackageReference Include="System.Text.Json" Version="8.0.5" />
	</ItemGroup>
</Project>
